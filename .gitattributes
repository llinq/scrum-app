# Force LF line endings for all text files
* text=auto eol=lf

# Force bash scripts to have unix line endings
*.sh text eol=lf

# Force batch scripts to have windows line endings  
*.bat text eol=crlf

# Ensure these file types always use LF
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.mjs text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.xml text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Ignore specific directories for exports
node_modules/ export-ignore
.next/ export-ignore
dist/ export-ignore
coverage/ export-ignore
