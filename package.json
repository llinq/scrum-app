{
  "name": "scrum-app",
  "version": "0.0.1",
  "private": true,
  "packageManager": "yarn@4.9.4",
  "workspaces": [
    "scrum-app-api",
    "scrum-app-web",
    "scrum-app-shared"
  ],
  "scripts": {
    "start": "concurrently \"yarn start:api\" \"yarn start:web\"",
    "start:api": "cd scrum-app-api && yarn start",
    "start:web": "cd scrum-app-web && yarn dev",
    "test": "echo \"Error: no test specified\" && exit 1",
    "ci:local": "bash scripts/local-ci.sh",
    "ci:local:windows": "scripts\\local-ci.bat",
    "lint": "concurrently \"yarn lint:api\" \"yarn lint:web\"",
    "lint:api": "cd scrum-app-api && yarn lint",
    "lint:web": "cd scrum-app-web && yarn lint",
    "build": "concurrently \"yarn build:api\" \"yarn build:web\"",
    "build:api": "cd scrum-app-api && yarn build",
    "build:web": "cd scrum-app-web && yarn build",
    "audit": "concurrently \"yarn audit:api\" \"yarn audit:web\"",
    "audit:api": "cd scrum-app-api && yarn audit",
    "audit:web": "cd scrum-app-web && yarn audit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llinq/scrum-app.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/llinq/scrum-app/issues"
  },
  "homepage": "https://github.com/llinq/scrum-app#readme",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@nestjs/common": "^11.1.13",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.13",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.13",
    "@nestjs/platform-socket.io": "^11.1.13",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.13",
    "axios": "^1.13.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "clsx": "^2.1.1",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.542.0",
    "next": "^15.5.12",
    "next-auth": "^4.24.13",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.18.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.13",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.10.11",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.5.12",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
